function GetHashTargetId() {
  return window.location.hash ? decodeURIComponent(window.location.hash.substring(1)) : "";
}

function ApplyHashRoute() {
  const contentParent = document.body ? document.body.getAttribute("data-content-parent") : "";
  const hashTarget = GetHashTargetId();
  if (!contentParent || !hashTarget) return false;

  const parent = document.getElementById(contentParent);
  const target = document.getElementById(hashTarget);
  if (!parent || !target) return false;

  let panel = target;
  while (panel && panel.parentElement !== parent) {
    panel = panel.parentElement;
  }

  if (panel && panel.id) {
    ToggleContent(contentParent, panel.id);
    ScrollToElement(hashTarget);
    return true;
  }

  ScrollToElement(hashTarget);
  return true;
}

