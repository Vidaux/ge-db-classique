function NormalizeCharacterSearchText(value) {
  return (value || "").toUpperCase().replace(/[^A-Z0-9]+/g, " ").trim();
}

var CharacterAvailability = null;
var CharacterAvailabilityDefaultActive = false;

function SetCharacterAvailability(data) {
  const byClassId = {};
  const byClassName = {};
  const byName = {};
  if (data && Array.isArray(data.characters)) {
    CharacterAvailabilityDefaultActive = data.defaultActive === true;
    for (let i = 0; i < data.characters.length; i++) {
      const character = data.characters[i];
      const active = character.active === true;
      if (character.classId !== undefined && character.classId !== null) {
        byClassId[String(character.classId)] = active;
      }
      if (character.className) {
        byClassName[String(character.className)] = active;
      }
      if (character.name) {
        byName[String(character.name)] = active;
      }
    }
    CharacterAvailability = {
      byClassId: byClassId,
      byClassName: byClassName,
      byName: byName
    };
  }
}

function IsCharacterActive(element) {
  const classId = element.getAttribute("data-class-id") || "";
  const className = element.getAttribute("data-class-name") || "";
  const name = element.getAttribute("data-name") || "";
  if (CharacterAvailability) {
    if (Object.prototype.hasOwnProperty.call(CharacterAvailability.byClassId, classId)) {
      return CharacterAvailability.byClassId[classId];
    }
    if (Object.prototype.hasOwnProperty.call(CharacterAvailability.byClassName, className)) {
      return CharacterAvailability.byClassName[className];
    }
    if (Object.prototype.hasOwnProperty.call(CharacterAvailability.byName, name)) {
      return CharacterAvailability.byName[name];
    }
    return CharacterAvailabilityDefaultActive;
  }
  return element.getAttribute("data-active") !== "false";
}

function SetCharacterVisibility(element, visible) {
  element.hidden = !visible;
  element.classList.toggle("is-character-filtered-out", !visible);
  element.style.display = visible ? "" : "none";
}

function LoadCharacterAvailability() {
  if (!document.getElementById("Character")) return;
  FilterCharacters();
  if (typeof fetch !== "function") return;
  fetch("./assets/data/character-availability.json", { cache: "no-store" })
    .then(function(response) {
      return response.ok ? response.json() : null;
    })
    .then(function(data) {
      if (!data) return;
      SetCharacterAvailability(data);
      FilterCharacters();
    })
    .catch(function() {
      FilterCharacters();
    });
}

function FilterCharacters() {
  var input, filter, table, tr, td, i, txtValue, cards;
  input = document.getElementById("myInput");
  filter = NormalizeCharacterSearchText(input ? input.value : "");
  table = document.getElementById("MyTable");

  if (table) {
    tr = table.getElementsByTagName("tr");
    for (i = 0; i < tr.length; i++) {
      td = tr[i].getElementsByTagName("td")[0];
      if (td) {
        txtValue = tr[i].getAttribute("data-search") || tr[i].textContent || tr[i].innerText || "";
        SetCharacterVisibility(tr[i], IsCharacterActive(tr[i]) && NormalizeCharacterSearchText(txtValue).indexOf(filter) > -1);
      }
    }
  }

  cards = document.querySelectorAll(".character-card");
  for (i = 0; i < cards.length; i++) {
    txtValue = cards[i].getAttribute("data-search") || cards[i].getAttribute("data-name") || cards[i].textContent || "";
    SetCharacterVisibility(cards[i], IsCharacterActive(cards[i]) && NormalizeCharacterSearchText(txtValue).indexOf(filter) > -1);
  }
}

function FilterMonsterTables() {
  const input = document.getElementById("MonsterSearch");
  const filter = input ? input.value.toUpperCase() : "";
  const rows = document.querySelectorAll("#Monsters .monster-table tbody tr");
  for (let i = 0; i < rows.length; i++) {
    const text = rows[i].textContent || rows[i].innerText || "";
