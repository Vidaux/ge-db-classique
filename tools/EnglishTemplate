function openNav() {
  const sideNav = document.getElementById("mySidenav");
  if (!sideNav || sideNav.classList.contains("is-docked")) return;
  sideNav.classList.add("is-open");
}

function closeNav() {
  const sideNav = document.getElementById("mySidenav");
  if (!sideNav) return;
  sideNav.classList.remove("is-open");
}

function setSidePanel(TargetDiv, mode) {
  const sideNav = document.getElementById("mySidenav");
  const browseButton = document.getElementById("browseButton");
  const closeButton = document.getElementById("closebtn");
  if (!sideNav) return;

  sideNav.classList.remove("is-open", "is-docked", "is-disabled");
  document.body.classList.remove("has-side-panel");

  if (TargetDiv) {
    ToggleContent("mySidenav", TargetDiv);
  }

  if (mode === "docked") {
    sideNav.classList.add("is-docked");
    document.body.classList.add("has-side-panel");
    if (browseButton) browseButton.style.display = "none";
    if (closeButton) closeButton.style.display = "none";
    return;
  }

  if (mode === "overlay") {
    if (browseButton) browseButton.style.display = "inline-flex";
    if (closeButton) closeButton.style.display = "inline-flex";
    return;
  }

  sideNav.classList.add("is-disabled");
  if (browseButton) browseButton.style.display = "none";
  if (closeButton) closeButton.style.display = "none";
}

