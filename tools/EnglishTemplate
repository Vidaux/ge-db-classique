  background: #222;
}

.sidenav.is-docked {
  top: var(--nav-offset);
  left: 18px;
  width: 280px;
  height: calc(100vh - var(--nav-offset) - 28px);
  max-width: 280px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #111;
  color: var(--ink);
  box-shadow: var(--shadow);
  transition: none;
}

