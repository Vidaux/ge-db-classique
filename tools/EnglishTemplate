  }
}

function SortCharacterCards(sortBy) {
  const grid = document.getElementById("CharacterCards");
  if (!grid) return;

  const cards = Array.from(grid.querySelectorAll(".character-card"));
  cards.sort(function(a, b) {
    if (sortBy === "main") {
      const statCompare = (a.getAttribute("data-main-stat") || "").localeCompare(b.getAttribute("data-main-stat") || "");
      if (statCompare !== 0) return statCompare;
      return Number(b.getAttribute("data-main-value") || 0) - Number(a.getAttribute("data-main-value") || 0);
    }

    if (sortBy && sortBy.indexOf("stat:") === 0) {
      const stat = sortBy.substring(5);
      return Number(b.getAttribute("data-" + stat) || 0) - Number(a.getAttribute("data-" + stat) || 0);
    }

    return (a.getAttribute("data-name") || "").localeCompare(b.getAttribute("data-name") || "");
  });

  for (let i = 0; i < cards.length; i++) {
    grid.appendChild(cards[i]);
  }
}

function UpdateCharacterCardLabels(sortBy) {
  const statNames = {
    str: "STR",
    agi: "AGI",
    dex: "DEX",
    hp: "HP",
    int: "INT",
    sen: "SEN"
  };
  const cards = document.querySelectorAll(".character-card");
  for (let i = 0; i < cards.length; i++) {
    const statLabel = cards[i].querySelector(".character-card-stat");
    if (!statLabel) continue;

    let text = "";
    if (sortBy === "main") {
      const mainStat = cards[i].getAttribute("data-main-stat") || "";
      const mainValue = cards[i].getAttribute("data-main-value") || "";
      text = mainStat && mainValue ? mainStat + " " + mainValue : "";
    } else if (sortBy && sortBy.indexOf("stat:") === 0) {
      const stat = sortBy.substring(5);
      const statName = statNames[stat] || stat.toUpperCase();
      const statValue = cards[i].getAttribute("data-" + stat) || "";
      text = statValue ? statName + " " + statValue : "";
    }

    statLabel.textContent = text;
    statLabel.style.display = text ? "" : "none";
  }
}

function SortCharacters(sortBy) {
  SortCharacterCards(sortBy);
  UpdateCharacterCardLabels(sortBy);
  const tableSortMap = {
    name: [0, "T"],
    main: [1, "T"],
    "stat:str": [2, "N"],
    "stat:agi": [3, "N"],
    "stat:dex": [4, "N"],
    "stat:hp": [5, "N"],
    "stat:int": [6, "N"],
    "stat:sen": [7, "N"]
  };
  if (document.getElementById("MyTable") && tableSortMap[sortBy]) {
    SortTable(tableSortMap[sortBy][0], tableSortMap[sortBy][1]);
  }
  FilterCharacters();
}

